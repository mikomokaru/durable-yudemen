node_modules/
dist/
.wrangler/
*.log
.DS_Store

# wrangler types output (regenerate with `pnpm cf-typegen`)
worker-configuration.d.ts
# 札の Worker の Env 型（regenerate with `pnpm short-names:types`）
src/display/worker-configuration.d.ts

# Kiro ローカル設定（MCP の認証トークン等の機微情報を含むため追跡しない）
.kiro/settings/

# Claude Code のローカル設定（この機械の絶対パスと許可キャッシュを含むため追跡しない）
.claude/

# Workers のローカル secret（ADMIN_TOKEN 等）。機微情報のため追跡しない。
.dev.vars

# graphify の生成物（graph.json / graph.html / GRAPH_REPORT.md / 抽出キャッシュ）。
# ソースから再生成できる派生物であり、履歴に載せる価値がない。
# 除外設定 .graphifyignore と抽出プロンプト .graphify/ は生成物ではないため追跡する。
/graphify-out/

# 観測ハーネスの実行時アーティファクト（Operation_Log / Instrumentation_Log の収集物）。
# シナリオ定義（tools/observe/scenarios/）はフィクスチャとして追跡する。
/operation-log.jsonl
/instrumentation-log.txt
/*.jsonl

# コードレビューツールの出力先。レビューの作業出力であり、成果は PR の本文と
# コミットメッセージに残る。履歴に載せると PR ごとに 20KB 級の分析文が積む。
/semantic-review/

# spec タスク実行のメタデータ（pbtResults / executionHistory）。
# この機械のセッション識別子（chatSessionId）と実行時刻の記録であり、spec の内容ではない。
# タスクの完了状態は tasks.md のチェックボックスが正本。
.kiro/specs/*/tasks.meta.json

# CP-SAT 実注文試験の原本・取得設定。コードと集計結果だけを追跡する。
/docs/data_samples/kenbaiki_orders/*.jsonl
/docs/data_samples/noodle_plan_histories/
/experiments/cpsat-workers/fixtures/local/
/experiments/cpsat-workers/**/__pycache__/
# 生成物（`pnpm poc:cpsat:build` が or-tools-wasm から作る）。6.8 MB の binary で、
# 上の方針「コードと集計結果だけを追跡する」に従い追跡しない。root の bundle は
# これを import しない（計画器は別 Worker）。
/experiments/cpsat-workers/vendor/*.wasm
