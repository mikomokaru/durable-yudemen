{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  // Deployment sequence step 3: no CP binding and disabled trial manifest.
  // No application binding points here until the later application deployment.
  "name": "yude-men-cpsat-transport-shim-dev",
  "account_id": "305d89a643ac689b4204454c5493cbde",
  "main": "./shim.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "services": [{ "binding": "SOLVER", "service": "yude-men-solver" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true },
  },
}
